---
/**
 * Ejemplo de página con i18n nativo de Astro 4.0
 * 
 * Esta página demuestra cómo usar:
 * - Astro.params para obtener el locale de la ruta dinámica
 * - Importar archivos JSON de traducción
 * - Generar rutas estáticas con getStaticPaths
 */
import Layout from '../../layouts/Layout.astro';
import LanguageSwitcher from '../../components/LanguageSwitcher.astro';
import esTranslations from '../../i18n/es.json';
import enTranslations from '../../i18n/en.json';

// Función para obtener traducciones según el idioma
function getTranslations(locale: string) {
  return locale === 'es' ? esTranslations : enTranslations;
}

// Función helper para obtener traducciones
function t(key: string, locale: string): string {
  const translations = getTranslations(locale);
  const keys = key.split('.');
  let value: any = translations;
  for (const k of keys) {
    value = value?.[k];
  }
  return typeof value === 'string' ? value : key;
}

// Obtener el locale desde los parámetros de la ruta
const currentLocale = Astro.params.lang || 'en';

// Obtener traducciones
const pageTitle = t('nav.home', currentLocale);
const aboutText = t('nav.about', currentLocale);
const menuText = t('nav.menu', currentLocale);
const reserveText = t('nav.reserve', currentLocale);
const footerDescription = t('footer.description', currentLocale);

// Exportar getStaticPaths para generar rutas estáticas
export async function getStaticPaths() {
  return [
    { params: { lang: 'en' } },
    { params: { lang: 'es' } },
  ];
}
---

<Layout title={`Amanto - ${pageTitle}`} description={footerDescription} lang={currentLocale}>
  <div class="bg-black overflow-hidden w-screen h-screen relative">
    <!-- Imagen de fondo - capa base -->
    <img
      id="background-image-1"
      class="absolute top-0 left-0 w-full h-full object-cover transition-opacity duration-500 ease-in-out z-0"
      alt="Amanto Restaurant"
      src="/images/mesa.webp" 
    />
    <!-- Imagen de fondo - capa superior para crossfade -->
    <img
      id="background-image-2"
      class="absolute top-0 left-0 w-full h-full object-cover transition-opacity duration-500 ease-in-out z-10 opacity-0"
      alt="Amanto Restaurant"
      src="/images/mesa.webp"
    />

    <!-- Logo superior izquierdo -->
    <a
      href={`/${currentLocale}`}
      class="absolute top-[3.5vh] left-[3.4vw] w-[60px] md:w-[9.8vw] h-auto z-50 cursor-pointer logo-container"
      role="img"
      aria-label="Amanto logo"
    >
      <!-- Logo para desktop -->
      <img 
        src="/images/logo.svg" 
        alt="Amanto" 
        class="hidden md:block w-full h-full object-contain logo-img"
        style="transition: filter 0.3s ease;"
      />
      <!-- Favicon para móvil -->
      <svg class="block md:hidden w-[50%] h-[50%] transition-colors duration-300" viewBox="0 0 32 31.72" xmlns="http://www.w3.org/2000/svg">
        <path class="logo-icon" fill="#ffffff" d="M16,14.98C8,9.26,0,3.83,0,0v31.72h6.43c1.13-3.05,5.3-6.21,9.57-9.16,4.26,2.95,8.44,6.11,9.57,9.16h6.43V0c0,3.83-8,9.26-16,14.98ZM6.43,22.31v-6.99c.94,1.08,2.46,2.28,4.24,3.56-1.5,1.15-2.94,2.29-4.24,3.43ZM21.33,18.88c1.78-1.27,3.3-2.47,4.24-3.56v6.99c-1.3-1.14-2.73-2.28-4.24-3.43Z"/>
      </svg>
    </a>
      
    <!-- Selector de idioma superior derecho -->
    <LanguageSwitcher currentLocale={currentLocale} />

    <!-- Navegación inferior -->
    <nav
      id="bottom-nav"
      class="absolute bottom-[10vh] md:bottom-[6vh] left-0 right-0 flex md:flex-row flex-col md:justify-center items-center md:gap-[8.5vw] gap-[4vh] z-50"
      role="navigation"
      aria-label="Main navigation"
    >
      <a
        href={`/${currentLocale}/nosotros`}
        data-bg="/images/nosotros.webp"
        class="nav-link text-white md:text-2xl text-sm md:tracking-[14.40px] tracking-[6px] leading-normal font-light whitespace-nowrap relative inline-block pb-1"
        style="font-family: 'Figtree', -apple-system, BlinkMacSystemFont, sans-serif; font-weight: 300;"
      >
        {aboutText}
      </a>
      <a
        href={`/${currentLocale}/carta`}
        data-bg="/images/plato4.webp"
        class="nav-link text-white md:text-2xl text-sm md:tracking-[14.40px] tracking-[6px] leading-normal font-light whitespace-nowrap relative inline-block pb-1"
        style="font-family: 'Figtree', -apple-system, BlinkMacSystemFont, sans-serif; font-weight: 300;"
      >
        {menuText}
      </a>
      <a
        href={`/${currentLocale}/reserva`}
        data-bg="/images/interior1.webp"
        class="nav-link text-white md:text-2xl text-sm md:tracking-[14.40px] tracking-[6px] leading-normal font-light whitespace-nowrap relative inline-block pb-1"
        style="font-family: 'Figtree', -apple-system, BlinkMacSystemFont, sans-serif; font-weight: 300;"
      >
        {reserveText}
      </a>
    </nav>
  </div>
          
  <style>
    /* Barra inferior con degradado para los enlaces de navegación */
    .nav-link::after {
      content: '';
      position: absolute;
      bottom: 0;
      left: 50%;
      transform: translateX(-50%);
      width: 0;
      height: 2px;
      background: linear-gradient(90deg, #f59e0b 0%, #d97706 50%, #b45309 100%);
      transition: width 0.5s ease-in-out;
    }

    .nav-link:hover::after {
      width: 100px;
    }

    /* Asegurar que no hay scroll */
    body {
      overflow: hidden;
    }
  </style>

  <script>
    // Función para inicializar el efecto hover del menú
    function setupNavHover() {
      const navLinks = document.querySelectorAll('.nav-link');
      const bgImage2 = document.getElementById('background-image-2') as HTMLImageElement | null;

      if (!bgImage2) return;

      navLinks.forEach(link => {
        if (link.hasAttribute('data-hover-setup')) {
          return;
        }
        
        link.setAttribute('data-hover-setup', 'true');
        
        link.addEventListener('mouseenter', () => {
          const newBg = link.getAttribute('data-bg');
          if (newBg && bgImage2) {
            bgImage2.src = newBg;
            bgImage2.style.opacity = '1';
          }
        });

        link.addEventListener('mouseleave', () => {
          if (bgImage2) {
            bgImage2.style.opacity = '0';
          }
        });
      });
    }

    // Inicializar al cargar la página
    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', setupNavHover);
    } else {
      setupNavHover();
    }

    // Reinicializar después de cada transición de View Transitions
    document.addEventListener('astro:page-load', () => {
      document.querySelectorAll('.nav-link[data-hover-setup]').forEach(link => {
        link.removeAttribute('data-hover-setup');
      });
      setupNavHover();
    });
  </script>
</Layout>

