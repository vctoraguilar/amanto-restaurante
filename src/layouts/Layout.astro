---
import { ViewTransitions } from 'astro:transitions';

export interface Props {
  title: string;
  description?: string;
  lang?: string;
}

const { title, description = "Restaurante Amanto - Experiencia culinaria única en un ambiente elegante", lang } = Astro.props;

// Obtener el idioma actual para el atributo lang del HTML
// Intentar obtener desde props, luego desde params, finalmente usar 'es' por defecto
const currentLang = lang || Astro.params?.lang || 'es';

// Construir la URL absoluta de la imagen de vista previa social
const imageUrl = `${Astro.url.origin}/social-preview.png`;
---

<!DOCTYPE html>
<html lang={currentLang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content={description} />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    
    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={Astro.url.href} />
    <meta property="og:image" content={imageUrl} />
    
    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageUrl} />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Figtree:wght@300;900&family=Questrial&display=swap" rel="stylesheet">
    <ViewTransitions />
  </head>
  <body class="font-body">
    <div id="aurora-background" class="fixed inset-0 z-0">
      <div class="aurora-bg absolute inset-0"></div>
      <div class="absolute inset-0 bg-black/20"></div>
    </div>
    
    <div class="relative z-10 min-h-screen">
      <slot />
    </div>

    <style is:global>
      .font-inter {
        font-family: 'Inter', sans-serif;
      }

      /* Hover del logo global para todo el sitio */
      .logo-container {
        cursor: pointer;
        text-decoration: none;
        display: block;
      }

      .logo-container:hover .logo-img,
      .logo-container:hover img[alt*="logo"][class*="object-contain"] {
        filter: invert(50%) sepia(90%) saturate(4858%) hue-rotate(4deg) brightness(180%) contrast(96%);
        transition: filter 0.3s ease;
      }

      /*.logo-container:hover .logo-icon,
      .logo-container:hover svg path {
        fill: #f49f13;
        transition: fill 0.3s ease;
      }*/

     </style>
  </body>
</html>
